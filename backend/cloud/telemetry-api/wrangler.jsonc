{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "packet-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "DRONE", "class_name": "DroneState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DroneState"] }]
  // Secrets (set with `wrangler secret put NAME`, or in .dev.vars for local dev):
  //   INGEST_TOKEN  - the laptop ground control server uses it to POST telemetry
  //   READ_TOKEN    - the app team uses it to read
  //   COMMAND_TOKEN - the backend uses it to send trip commands (goto/hold/resume/return)
}
