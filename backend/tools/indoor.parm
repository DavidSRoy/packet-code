# Indoor flight: the EKF never uses GPS (the receiver still reports, for the map only).
# Normal sources (set 1): no horizontal position or speed, baro height, compass heading.
# The hover switches to set 2 (box camera) as before. Undo with tools/outdoor.parm.
EK3_SRC1_POSXY,0
EK3_SRC1_VELXY,0
EK3_SRC1_VELZ,0
EK3_SRC1_POSZ,1
EK3_SRC1_YAW,1
AHRS_GPS_USE,0
FENCE_ENABLE,0
