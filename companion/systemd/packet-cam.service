[Unit]
Description=Packet: box camera stream and lid pose (HTTP :8080, pose over the radio)
After=network.target packet-tunnel.service

[Service]
User=packet
WorkingDirectory=/home/packet/companion
ExecStart=/home/packet/companion/.venv/bin/python -u cam_stream.py --width 1280 --height 720 --fps 15
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
