/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deploys go through Cloudflare Workers Builds (the GitHub integration), not a
 * GitHub Actions workflow. Workers Builds ignores this file's build command.
 * Set these in the Worker settings, under Build:
 *   Root directory: landing
 *   Production branch: master
 *   Build command: npx opennextjs-cloudflare build
 *   Deploy command: npx opennextjs-cloudflare deploy
 *   Preview command: npx wrangler preview (with Enable Preview Builds turned on)
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "packet-landing",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "packet-landing"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "packet-landing",
			"database_id": "fb7fbcd8-cbb4-4073-a770-7881de5ba572",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Previews: every push to a branch other than master gets its own Preview URL
	 * (Workers Builds runs the build command, then `npx wrangler preview`).
	 * Previews do not inherit the settings above, so each binding is repeated here.
	 * Previews write signups to packet-landing-preview, never to production.
	 * Apply new migrations to it with:
	 *   npx wrangler d1 migrations apply packet-landing-preview --remote --config wrangler.preview-migrations.jsonc
	 */
	"previews": {
		"images": {
			"binding": "IMAGES"
		},
		"services": [
			{
				// A Preview's service binding calls the production deployment of packet-landing.
				"binding": "WORKER_SELF_REFERENCE",
				"service": "packet-landing"
			}
		],
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "packet-landing-preview",
				"database_id": "4b53c0ad-b148-45cb-81ce-732d5470fd4c",
				"migrations_dir": "migrations"
			}
		]
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
}